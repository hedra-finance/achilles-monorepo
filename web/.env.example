# Public RPC only. Never put an internal node address here or in code.
# The settlement hub exposes the tranche precompiles; point this at its RPC.
NEXT_PUBLIC_HUB_RPC=
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ROBINHOOD_RPC=https://rpc.testnet.chain.robinhood.com
# Reown (WalletConnect) project id — without it, only browser-extension wallets show up
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Server-only: Hub ProductAdmin, HumanRegistry verifier, test-token minting and gas funding key.
# Never sent to the browser.
OPS_PRIVATE_KEY=
INVITE_CODE=

# World ID (developer.world.org). App and RP ids are public; the signing key is not.
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
NEXT_PUBLIC_WORLD_ENV=production
RP_SIGNING_KEY=

# The cadence the settlement keeper actually runs at, when it is shorter than the schedule the product
# was registered with. Leave empty to display the registered one.
NEXT_PUBLIC_SETTLE_SECS=600

# MultiBaas (Curvegrid) — indexes the Sepolia contracts and serves their decoded events.
# The reader key is enough for the activity panel; the admin key is only needed to register contracts.
MULTIBAAS_URL=
MULTIBAAS_ACHILLES_READER=
MULTIBAAS_ACHILLES_ADMIN=
